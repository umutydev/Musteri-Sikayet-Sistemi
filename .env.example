# Uygulama
APP_NAME=Bankacilik Talep ve Sikayet Sistemi
API_V1_PREFIX=/api/v1
ENV=development

# Veritabani (PostgreSQL)
# Yerelde Postgres kurulduysa asagidaki gibi kullan; docker-compose ile de calisir.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sikayet_db

# JWT
JWT_SECRET_KEY=degistir-bu-cok-gizli-bir-anahtar-olmali
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Dosya yukleme (v1: yerel disk)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
