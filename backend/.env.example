# Uygulama
APP_NAME=Bankacilik Talep ve Sikayet Sistemi
API_V1_PREFIX=/api/v1
ENV=development

# Veritabani (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sikayet_db

# JWT
JWT_SECRET_KEY=degistir-bu-cok-gizli-bir-anahtar-olmali
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Dosya yukleme
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- E-posta ---
# console : e-postalar gonderilmez, sunucu loguna yazilir (gelistirme icin)
# smtp    : gercek e-posta gonderilir
EMAIL_BACKEND=console

# Gercek gonderim icin EMAIL_BACKEND=smtp yapip asagidakileri doldurun.
# Gmail kullaniyorsaniz:
#   1. Google Hesabim > Guvenlik > 2 Adimli Dogrulama'yi acin
#   2. Ayni sayfada "Uygulama Sifreleri" bolumunden bir sifre olusturun
#   3. Olusan 16 haneli sifreyi SMTP_PASSWORD alanina yazin
#      (normal Gmail sifreniz CALISMAZ)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Banka Destek
